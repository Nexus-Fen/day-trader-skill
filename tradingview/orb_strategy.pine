//@version=6
// ORB Day Trader : la stratégie du skill day-trader-skill (fork Nexus-Fen, branche mt5-demo),
// en version backtest pour TradingView.
//
// Mêmes règles que les scripts Python :
//   - range d'ouverture = plus haut / plus bas de 9:30 à 9:45 (New York), soit 3 bougies de 5 minutes
//   - entrée = la PREMIÈRE bougie terminée qui CLÔTURE au-dessus du haut du range (une mèche ne compte pas),
//     si elle clôture entre 09:45 et 15:30 New York, au prix de clôture
//   - stop = milieu du range (arrondi vers le bas), objectif = 1R, à plat à 15:55 quoi qu'il arrive
//   - taille = perte max par trade / risque par action, arrondie vers le bas
//   - long uniquement, un seul trade par jour et par symbole
//
// Utilisation : graphique en 5 minutes, séance régulière (RTH). Ce n'est pas un conseil financier.

strategy("ORB Day Trader (backtest)", shorttitle = "ORB DTS", overlay = true,
     initial_capital = 5000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = true, commission_type = strategy.commission.cash_per_order,
     commission_value = 0, slippage = 0, max_labels_count = 500)

// ---------------------------------------------------------------- réglages
grpR = "Range d'ouverture"
orMinutes = input.int(15, "Durée du range (minutes)", minval = 5, maxval = 60, step = 5, group = grpR)

grpE = "Entrée"
entryFrom = input.string("09:45", "Pas d'entrée avant (heure de New York)", group = grpE)
entryTo   = input.string("15:30", "Pas d'entrée après (heure de New York)", group = grpE)
minVolX   = input.float(0.0, "Volume mini de la bougie (x volume moyen du range, 0 = sans filtre)", minval = 0, step = 0.1, group = grpE)
useSpy    = input.bool(false, "Filtre marché : seulement si SPY est au-dessus de son ouverture", group = grpE)
spySym    = input.symbol("AMEX:SPY", "Indice de référence du filtre", group = grpE)

grpX = "Sortie"
stopMode = input.string("Milieu du range", "Stop", options = ["Milieu du range", "Bas du range", "Pourcentage"], group = grpX)
stopPct  = input.float(1.0, "Stop en % sous l'entrée (si Pourcentage)", minval = 0.1, step = 0.1, group = grpX)
targetR  = input.float(1.0, "Objectif (multiple du risque R)", minval = 0.5, step = 0.5, group = grpX)
flatBy   = input.string("15:55", "À plat avant (heure de New York)", group = grpX)

grpS = "Taille et risque"
maxLoss  = input.float(50, "Perte max par trade ($)", minval = 1, group = grpS)
maxOrder = input.float(4000, "Montant max par ordre ($)", minval = 1, group = grpS)

grpD = "Affichage"
showTable = input.bool(true, "Tableau du jour", group = grpD)

// ---------------------------------------------------------------- outils
TZ = "America/New_York"
OPEN_MIN = 9 * 60 + 30

toMin(string s) =>
    array<string> parts = str.split(s, ":")
    int result = na
    if array.size(parts) == 2
        float h = str.tonumber(array.get(parts, 0))
        float m = str.tonumber(array.get(parts, 1))
        if not na(h) and not na(m)
            result := int(h) * 60 + int(m)
    result

// un stop long s'arrondit vers le bas (loin de l'entrée), un objectif au plus proche
floorTick(float x) => math.floor(x / syminfo.mintick + 1e-9) * syminfo.mintick
roundTick(float x) => math.round(x / syminfo.mintick) * syminfo.mintick
fmt(float x) => str.tostring(x, format.mintick)

int fromMin = toMin(entryFrom)
int toMinV  = toMin(entryTo)
int flatMin = toMin(flatBy)
// Réglages invalides : pas d'erreur, le script s'arrête proprement et le tableau explique pourquoi.
bool hoursOk = not na(fromMin) and not na(toMinV) and not na(flatMin)
bool tfOk    = timeframe.isintraday and timeframe.in_seconds() <= orMinutes * 60 and (orMinutes * 60) % timeframe.in_seconds() == 0
string setupMsg = not tfOk ? "Passez le graphique en 5 minutes (unité actuelle : " + timeframe.period + ")" : not hoursOk ? "Heures au format HH:MM, par exemple 09:45" : ""
bool active  = tfOk and hoursOk

int barStart = hour(time, TZ) * 60 + minute(time, TZ)
int barEnd   = hour(time_close, TZ) * 60 + minute(time_close, TZ)
int nyDay    = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool newDay  = nyDay != nyDay[1]
int orEnd    = OPEN_MIN + orMinutes

// ---------------------------------------------------------------- état du jour
var float orHigh   = na
var float orLow    = na
var float orVolSum = 0.0
var int   orBars   = 0
var bool  traded   = false
var float entryPx  = na
var float stopPx   = na
var float tgtPx    = na
var int   qtyDay   = na
var string note    = ""

// le trade s'est fermé à la bougie précédente : on garde son résultat pour le tableau
if strategy.position_size == 0 and strategy.position_size[1] > 0 and strategy.closedtrades > 0
    note := "Clôturé : " + strategy.closedtrades.exit_comment(strategy.closedtrades - 1)

if newDay
    if strategy.position_size > 0
        strategy.close_all(comment = "Nouveau jour")
    orHigh   := na
    orLow    := na
    orVolSum := 0.0
    orBars   := 0
    traded   := false
    entryPx  := na
    stopPx   := na
    tgtPx    := na
    qtyDay   := na
    note     := ""

// ---------------------------------------------------------------- le range
bool inOr = active and barStart >= OPEN_MIN and barStart < orEnd
if inOr
    orHigh   := na(orHigh) ? high : math.max(orHigh, high)
    orLow    := na(orLow) ? low : math.min(orLow, low)
    orVolSum += volume
    orBars   += 1
bool orReady = orBars > 0 and barStart >= orEnd
float orMid  = (roundTick(orHigh) + roundTick(orLow)) / 2

// ---------------------------------------------------------------- l'entrée
float avgOrVol = orBars > 0 ? orVolSum / orBars : na
bool volOk     = minVolX <= 0 or (avgOrVol > 0 and volume >= minVolX * avgOrVol)
bool inWindow  = barEnd >= fromMin and barEnd <= toMinV
// Filtre marché : le premier signal du jour n'est pris que si SPY monte depuis l'ouverture.
// Sinon la journée est sautée (pas d'attente d'un signal plus tard), comme dans l'étude.
float spyOpen = request.security(spySym, "D", open, lookahead = barmerge.lookahead_on)
float spyNow  = request.security(spySym, timeframe.period, close)
bool spyOk    = not useSpy or (not na(spyNow) and not na(spyOpen) and spyNow > spyOpen)
bool breakout = active and orReady and not traded and inWindow and close > orHigh and volOk and strategy.position_size == 0
bool trigger  = breakout and spyOk
if breakout and not spyOk
    traded := true
    note := "Signal ignoré : SPY sous son ouverture"

bool entered = false
if trigger
    traded := true
    float e = roundTick(close)
    float s = stopMode == "Milieu du range" ? floorTick(orMid) : stopMode == "Bas du range" ? floorTick(roundTick(orLow)) : floorTick(e * (1 - stopPct / 100))
    float risk = e - s
    if risk <= 0 or risk < e * 0.0005
        note := "Signal refusé : stop trop proche (moins de 0,05 % du prix)"
    else
        float t = roundTick(e + targetR * risk)
        int q = math.min(math.floor(maxLoss / risk), math.floor(maxOrder / e))
        if q < 1
            note := "Signal refusé : le risque d'une action dépasse la perte max"
        else
            entryPx := e
            stopPx  := s
            tgtPx   := t
            qtyDay  := q
            entered := true
            strategy.entry("ORB", strategy.long, qty = q, comment = "ORB " + str.tostring(q))
            strategy.exit("Sortie", from_entry = "ORB", stop = s, limit = t, comment_loss = "Stop", comment_profit = "Objectif")
            note := "En position"
            label.new(bar_index, low, "ORB " + str.tostring(q) + " @ " + fmt(e) + "\nStop " + fmt(s) + "\nObjectif " + fmt(t) + "\nPerte max " + str.tostring(q * risk, "#.##") + " $", style = label.style_label_up, color = color.new(color.green, 15), textcolor = color.white, size = size.small)
            alert("ORB " + syminfo.ticker + " : achat " + str.tostring(q) + " @ " + fmt(e) + ", stop " + fmt(s) + ", objectif " + fmt(t), alert.freq_once_per_bar_close)

// ---------------------------------------------------------------- à plat avant la clôture
if strategy.position_size > 0 and barEnd >= flatMin
    strategy.close_all(comment = "À plat " + flatBy)

// ---------------------------------------------------------------- dessin
bool showRange = not na(orHigh) and barStart < flatMin
plot(showRange ? orHigh : na, "Haut du range", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(showRange ? orLow : na, "Bas du range", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(showRange and orReady ? orMid : na, "Milieu du range", color = color.new(color.gray, 30), style = plot.style_linebr)
bool showPlan = not na(entryPx) and barStart < flatMin
plot(showPlan ? stopPx : na, "Stop", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
plot(showPlan ? tgtPx : na, "Objectif", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 2)
bgcolor(inOr ? color.new(color.teal, 88) : na, title = "Range en formation")
plotshape(entered, "Signal ORB", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)

var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1)
if (showTable or setupMsg != "") and barstate.islast
    string st = setupMsg != "" ? setupMsg : na(orHigh) ? "En attente de 09:30 New York" : not orReady ? "Range en formation" : note != "" ? note : barEnd > toMinV ? "Pas de signal aujourd'hui" : "Attend une clôture > " + fmt(orHigh)
    table.cell(tb, 0, 0, "ORB " + syminfo.ticker, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, st, text_color = color.yellow, text_size = size.small)
    table.cell(tb, 0, 1, "Range", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, na(orHigh) ? "-" : fmt(orLow) + " - " + fmt(orHigh), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Entrée", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, na(entryPx) ? "-" : fmt(entryPx), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Stop", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, na(stopPx) ? "-" : fmt(stopPx), text_color = color.red, text_size = size.small)
    table.cell(tb, 0, 4, "Objectif", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, na(tgtPx) ? "-" : fmt(tgtPx), text_color = color.green, text_size = size.small)
    table.cell(tb, 0, 5, "Quantité", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, na(qtyDay) ? "-" : str.tostring(qtyDay), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 6, "Perte max", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 6, na(qtyDay) ? "-" : str.tostring(qtyDay * (entryPx - stopPx), "#.##") + " $", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 7, "À plat", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 7, flatBy + " New York", text_color = color.white, text_size = size.small)
